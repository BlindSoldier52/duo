{
  "name": "duo",
  "version": "1.0.25",
  "private": true,
  "type": "module",
  "bin": {
    "duo": "duo.mjs"
  },
  "description": "A private web workspace for Codex and Claude collaboration, planning, implementation, and independent review.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.4.0"
  },
  "scripts": {
    "web": "node duo.mjs web",
    "install-duo": "node scripts/install-duo.mjs",
    "bump-version": "node scripts/bump-version.mjs",
    "check-version": "node scripts/bump-version.mjs --check",
    "prebuild": "node scripts/generate-app-server-types.mjs",
    "build": "tsc -p tsconfig.app-server.json",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^6.0.2"
  }
